{
    "cmake.useCMakePresets": "always",
    "cmake.cmakePath": "C:/Program Files/CMake/bin/cmake.exe",
    "cmake.defaultConfigurePreset": "win-msvc2019-qtcore-ninja-debug",
    "cmake.defaultBuildPreset": "win-msvc2019-qtcore-ninja-debug",
    "cmake.configureOnOpen": false,
    "cmake.buildBeforeRun": false,
    "cmake.automaticReconfigure": false,
    "cmake.buildTask": false,

    "task.allowAutomaticTasks": "off",

    "clangd.enable": true,
    "clangd.path": "clangd",
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy=false",
        "--header-insertion=never",
        "--completion-style=detailed"
    ],
    "clangd.onConfigChanged": "restart",

    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "C_Cpp.formatting": "Disabled",
    "C_Cpp.autoAddFileAssociations": false,
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/win-msvc2019-qtcore-ninja-debug/compile_commands.json",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.workspaceSymbols": "None",
    "C_Cpp.enhancedColorization": "Disabled",

    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.definitionLinkOpensInPeek": false,

    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },

    "files.exclude": {
        "**/build": true,
        "**/build2": true,
        "**/build-*": true,
        "**/cmake-build-*": true,
        "**/out": true,
        "**/.cache": true,
        "**/.vs": true,
        "**/.idea": true,
        "**/Log": true,
        "**/logs": true,
        "**/_xfer": true,
        "**/*.log": true,
        "**/third_party/**/data/**": true,
        "**/third_party/**/config/**": true,
        "**/third_party/**/logs/**": true,
        "**/third_party/**/bin/**": true,
        "**/third_party/**/lib/**": true,
        "**/third_party/**/runtime/**": true
    },
    "search.exclude": {
        "**/build": true,
        "**/build2": true,
        "**/build-*": true,
        "**/cmake-build-*": true,
        "**/out": true,
        "**/.cache": true,
        "**/.vs": true,
        "**/.idea": true,
        "**/Log": true,
        "**/logs": true,
        "**/_xfer": true,
        "**/*.log": true,
        "**/*.obj": true,
        "**/*.pdb": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/third_party/**/bin/**": true,
        "**/third_party/**/lib/**": true,
        "**/third_party/**/runtime/**": true,
        "**/third_party/**/logs/**": true,
        "**/third_party/**/data/**": true,
        "**/third_party/**/config/**": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/build2/**": true,
        "**/build-*/**": true,
        "**/cmake-build-*/**": true,
        "**/out/**": true,
        "**/.cache/**": true,
        "**/.git/**": true,
        "**/.vs/**": true,
        "**/.idea/**": true,
        "**/Log/**": true,
        "**/logs/**": true,
        "**/_xfer/**": true,
        "**/third_party/**/bin/**": true,
        "**/third_party/**/lib/**": true,
        "**/third_party/**/runtime/**": true,
        "**/third_party/**/logs/**": true,
        "**/third_party/**/data/**": true,
        "**/third_party/**/config/**": true
    }
}
